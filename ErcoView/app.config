    <add name="ErcoView.My.MySettings.ErcoView_LiveConnectionString4" connectionString="Data Source=ICES3\SQL_BT;Initial Catalog=ErcoView_Live;Integrated Security=True"/>
    <add name="ErcoView.My.MySettings.ConnectionString" connectionString="Data Source=ICES3\SQL_BT;Initial Catalog=ErcoView_Live;Integrated Security=True"/>
