  <connectionStrings>
    <add name="ErcoView_LiveEntities" connectionString="metadata=res://*/DataSets.Model1.csdl|res://*/DataSets.Model1.ssdl|res://*/DataSets.Model1.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=ICES2\SQL_PROJECTS;initial catalog=ErcoView_Live;integrated security=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient"/>
